{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "commandWindows": "py -3 -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','session_start.py'),run_name='__main__')\"",
            "timeout": 15,
            "statusMessage": "Loading agent communications identity",
            "additionalContextLimit": 2500
          }
        ]
      }
    ]
  }
}
