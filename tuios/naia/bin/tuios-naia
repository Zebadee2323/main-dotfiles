#!/usr/bin/env python3
"""Find a workspace's editor, then reuse its installed Naia launcher."""

import json
import os
from pathlib import Path
import subprocess
import sys


BIN = Path(__file__).resolve().parent


class DiscoveryError(Exception):
    pass


def warn(message):
    print(f"tuios-naia: {message}", file=sys.stderr)


def run(argv):
    # Never echo subprocess output: a future editor response could contain secrets.
    try:
        result = subprocess.run(argv, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise DiscoveryError(f"could not run {argv[0]}") from error
    if result.returncode:
        raise DiscoveryError(f"{argv[0]} discovery command failed")
    return result.stdout


def cli_path(target, env):
    """Remove shim directories from PATH so the attachment launcher cannot recurse."""
    directories = []
    executable = None
    for entry in env.get("PATH", os.defpath).split(os.pathsep):
        candidate = Path(entry or ".") / target
        if candidate.resolve() == (BIN / target).resolve():
            continue
        directories.append(entry)
        if executable is None and candidate.is_file() and os.access(candidate, os.X_OK):
            executable = str(candidate.absolute())
    if executable is None:
        raise DiscoveryError(f"no real {target} executable found after excluding the shim")
    return executable, os.pathsep.join(directories)


def workspace_panes(env):
    session = env.get("TUIOS_SESSION")
    pane_id = env.get("TUIOS_PANE_ID") or env.get("TUIOS_WINDOW_ID")
    if not session or not pane_id:
        raise DiscoveryError("missing tuios session/pane identity")
    data = json.loads(run(["tuios", "list-windows", "-s", session, "--json"]))
    windows = data["windows"]
    own = next((pane for pane in windows if pane["window_id"] == pane_id), None)
    if own is None or own.get("workspace") is None:
        raise DiscoveryError("launching pane is not in the reported session")
    # Use the caller's workspace, NOT the workspace currently focused by a client.
    return [pane for pane in windows if pane.get("workspace") == own["workspace"]]


def process_table(text):
    processes = {}
    for line in text.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) == 3:
            pid, parent, command = parts
            processes[int(pid)] = (int(parent), Path(command).name)
    return processes


def belongs_to(pid, root, processes):
    seen = set()
    while pid not in seen:
        if pid == root:
            return True
        seen.add(pid)
        if pid not in processes:
            return False
        pid = processes[pid][0]
    return False


def sockets_for(pids):
    if not pids:
        return []
    # Naia/Neovim can fork: the RPC server may be a headless child with no TTY.
    text = run(["lsof", "-n", "-a", "-p", ",".join(map(str, sorted(pids))), "-U", "-Fpn"])
    sockets = []
    for line in text.splitlines():
        if line.startswith("n/") and line[1:] not in sockets:
            sockets.append(line[1:])
    return sockets


def probe(socket):
    # No credentials leave the editor during discovery. The launcher queries them later.
    lua = """(function()
      local ok, naia = pcall(require, 'naia')
      if not ok or not naia.is_ready() then return '' end
      return vim.json.encode({pid=vim.fn.getpid(), wrapper=naia.wrapper_path()})
    end)()"""
    expression = "luaeval(" + json.dumps(lua) + ")"
    try:
        raw = run(["nvim", "--headless", "--server", socket, "--remote-expr", expression])
        return json.loads(raw) if raw.strip() else None
    except (DiscoveryError, ValueError):
        return None


def discover(env):
    panes = workspace_panes(env)
    selection = env.get("TUIOS_NAIA_PANE")
    if selection:
        panes = [pane for pane in panes if pane["window_id"].startswith(selection)]
        if len(panes) != 1:
            raise DiscoveryError("TUIOS_NAIA_PANE must uniquely identify a pane in this workspace")
    processes = process_table(run(["ps", "-axo", "pid=,ppid=,comm="]))
    owners = {}
    for pane in panes:
        root = int(pane["pid"])
        for pid, (_, command) in processes.items():
            if command == "nvim" and belongs_to(pid, root, processes):
                owners[pid] = pane["window_id"]
    matches = {}
    for socket in sockets_for(owners):
        info = probe(socket)
        if not isinstance(info, dict) or info.get("pid") not in owners:
            continue
        wrapper = info.get("wrapper")
        if not isinstance(wrapper, str) or not Path(wrapper).is_file():
            continue
        matches[info["pid"]] = (socket, wrapper, owners[info["pid"]])
    if len(matches) > 1:
        panes = ", ".join(sorted({item[2] for item in matches.values()}))
        raise DiscoveryError(f"multiple ready editors ({panes}); set TUIOS_NAIA_PANE to select one")
    return next(iter(matches.values()), None)


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if not argv or argv[0] not in {"opencode", "codex", "claude"}:
        warn("usage: tuios-naia {opencode|codex|claude} [arguments...]")
        return 2
    target, *args = argv
    env = os.environ.copy()
    try:
        executable, path = cli_path(target, env)
    except DiscoveryError as error:
        warn(str(error))
        return 127
    env["PATH"] = path
    if env.get("TUIOS_ENV") == "1":
        # Never accidentally connect to an inherited editor in another workspace.
        for name in ("NVIM", "NVIM_LISTEN_ADDRESS", "NAIA_MCP_TOKEN"):
            env.pop(name, None)
        try:
            editor = discover(env)
        except (DiscoveryError, ValueError, KeyError, TypeError) as error:
            warn(str(error))
            # Ambiguity/errors must not silently select an unintended editor.
            return 1
        if editor:
            socket, wrapper, pane = editor
            env["NVIM"] = socket
            warn(f"using Neovim in pane {pane}")
            os.execve(sys.executable, [sys.executable, wrapper, target, *args], env)
            return 0
        if env.get("TUIOS_NAIA_PANE"):
            warn("selected pane has no ready Naia editor")
            return 1
        warn("no ready Naia editor in this workspace; launching normally")
    os.execve(executable, [target, *args], env)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
