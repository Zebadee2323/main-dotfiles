#!/usr/bin/env python3

import json
import os
import shlex
import subprocess
import sys
from urllib.parse import urlsplit


def warn(message):
    print(f"sidekick-naia-cli: {message}", file=sys.stderr)


SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
AGENT_INSTRUCTIONS_FILE = os.path.join(SCRIPT_DIR, "agent-instructions.md")
AGENT_REMINDER_FILE = os.path.join(SCRIPT_DIR, "agent-reminder.md")
OPENCODE_PLUGIN_DIR = os.path.realpath(os.path.join(SCRIPT_DIR, "..", "opencode", "naia"))
MCP_TOKEN_ENV = "NAIA_MCP_TOKEN"


def notify_nvim(message, level="INFO"):
    nvim_server = os.environ.get("NVIM") or os.environ.get("NVIM_LISTEN_ADDRESS")
    if not nvim_server:
        return

    lua_chunk = """
(function(args)
  local msg, level_name = args[1], args[2]
  vim.schedule(function()
    local level = vim.log.levels[level_name] or vim.log.levels.INFO
    vim.notify(msg, level, { title = "Sidekick Naia" })
  end)
  return true
end)(_A)
""".strip()
    expr = "luaeval(%s, %s)" % (
        json.dumps(lua_chunk),
        json.dumps([message, level]),
    )

    try:
        subprocess.run(
            ["nvim", "--headless", "--server", nvim_server, "--remote-expr", expr],
            capture_output=True, text=True, check=False, timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return


def deep_merge(base, override):
    if not isinstance(base, dict) or not isinstance(override, dict):
        return override

    merged = dict(base)
    for key, value in override.items():
        if key in merged and isinstance(merged[key], dict) and isinstance(value, dict):
            merged[key] = deep_merge(merged[key], value)
        else:
            merged[key] = value
    return merged


def get_naia_connection_info():
    nvim_server = os.environ.get("NVIM") or os.environ.get("NVIM_LISTEN_ADDRESS")
    if not nvim_server:
        return None

    lua_chunk = """
(function()
  local ok, naia = pcall(require, "naia")
  if not ok then
    return ""
  end

  local info = naia.connection_info()
  return info and vim.json.encode(info) or ""
end)()
""".strip()
    expr = "luaeval(%s)" % json.dumps(lua_chunk)

    try:
        result = subprocess.run(
            ["nvim", "--headless", "--server", nvim_server, "--remote-expr", expr],
            capture_output=True, text=True, check=False, timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        warn("failed to query Naia bridge info from Neovim")
        return None
    if result.returncode != 0:
        stderr = result.stderr.strip()
        if stderr:
            warn("failed to query Naia bridge info from Neovim")
        return None

    payload = result.stdout.strip()
    if not payload:
        return None

    try:
        parsed = json.loads(payload)
    except json.JSONDecodeError:
        warn("unexpected Naia bridge info response")
        return None

    try:
        endpoint = urlsplit(parsed["url"])
        valid = (endpoint.scheme == "http" and endpoint.hostname == "127.0.0.1"
                 and endpoint.port is not None and 0 < endpoint.port < 65536
                 and not endpoint.username and not endpoint.password
                 and endpoint.path == "/" and not endpoint.query and not endpoint.fragment
                 and isinstance(parsed["token"], str) and bool(parsed["token"])
                 and not any(c.isspace() or ord(c) < 32 for c in parsed["token"]))
    except (KeyError, TypeError, ValueError):
        valid = False
    if not valid:
        warn("unexpected Naia bridge info payload")
        return None

    return {"url": parsed["url"], "token": parsed["token"]}


def build_opencode_env(env, connection_info):
    env = dict(env)
    env[MCP_TOKEN_ENV] = connection_info["token"]
    payload = {
        "mcp": {
            "servers": {
                "naia": {
                    "type": "remote",
                    "url": connection_info["url"],
                    "oauth": False,
                    "headers": {"Authorization": "Bearer {env:" + MCP_TOKEN_ENV + "}"},
                    "disabled": False,
                }
            }
        },
    }

    existing = env.get("OPENCODE_CONFIG_CONTENT")
    if existing:
        try:
            parsed = json.loads(existing)
            if not isinstance(parsed, dict):
                raise ValueError("configuration must be an object")
        except ValueError:
            warn("invalid OPENCODE_CONFIG_CONTENT, replacing it with Naia MCP config")
            parsed = {}
    else:
        parsed = {}

    merged = deep_merge(parsed, payload)
    # Replace our server as a whole, including any inherited V1 definition.
    merged["mcp"].pop("naia", None)
    merged["mcp"]["servers"]["naia"] = payload["mcp"]["servers"]["naia"]
    plugins = merged.setdefault("plugins", [])
    if not isinstance(plugins, list):
        raise ValueError("OpenCode plugins configuration must be a list")
    # Keep caller plugins and make repeated preparation idempotent.
    plugins = [entry for entry in plugins
               if entry != OPENCODE_PLUGIN_DIR
               and not (isinstance(entry, dict) and entry.get("package") == OPENCODE_PLUGIN_DIR)]
    merged["plugins"] = plugins + [OPENCODE_PLUGIN_DIR]
    # The plugin now owns Naia instructions. Remove only our legacy config
    # entry; unrelated caller instruction files must remain untouched.
    if isinstance(merged.get("instructions"), list):
        merged["instructions"] = [path for path in merged["instructions"] if path != AGENT_INSTRUCTIONS_FILE]
        if not merged["instructions"]:
            del merged["instructions"]

    env["OPENCODE_CONFIG_CONTENT"] = json.dumps(merged)
    return env


def read_agent_instructions():
    try:
        with open(AGENT_INSTRUCTIONS_FILE, "r", encoding="utf-8") as handle:
            return handle.read()
    except OSError as error:
        warn(f"failed to read agent instructions file: {error}")
        return None


def opencode_session_options(argv):
    """Identify session launches without treating run messages as directories."""
    mode = "tui"
    connection_args = []
    value_flags = {
        "--server", "--session", "-s", "--prompt", "--log-level",
        "--model", "-m", "--agent", "--format", "--file", "-f",
        "--title", "--replay-limit",
    }
    index = 0
    positional_seen = False
    while index < len(argv):
        arg = argv[index]
        flag, separator, value = arg.partition("=")
        if flag in {"--help", "-h", "--version", "-v", "--completions", "--wizard"}:
            return None
        if arg == "--":
            tail = argv[index + 1:]
            if mode == "tui" and tail:
                if len(tail) != 1 or positional_seen:
                    raise ValueError("expected one OpenCode workspace directory")
            break
        if flag in value_flags:
            if not separator:
                index += 1
                if index >= len(argv):
                    raise ValueError(f"missing value for {flag}")
                value = argv[index]
            if flag == "--server":
                connection_args += ["--server", value]
        else:
            if arg == "--standalone":
                connection_args.append(arg)
            if not arg.startswith("-") and not positional_seen:
                positional_seen = True
                if arg in {"run", "mini"}:
                    mode = arg
                elif not os.path.isdir(os.path.expanduser(arg)):
                    # Other subcommands (api, mcp, service, etc.) do not
                    # start a conversation and must not receive Naia config.
                    return None
        index += 1

    return {"connection_args": connection_args}


def build_opencode_args(argv):
    options = opencode_session_options(argv)
    if options is None:
        return argv
    if "--server" in options["connection_args"]:
        raise ValueError("Naia requires a private server, not an explicit --server")
    instructions = read_agent_instructions()
    if not instructions or not instructions.strip():
        raise ValueError("cannot launch Naia without a readable, non-empty agent instructions file")
    if not os.path.isfile(os.path.join(OPENCODE_PLUGIN_DIR, "index.js")):
        raise ValueError("cannot launch Naia without the OpenCode instructions plugin")
    # Let OpenCode handle new/resumed/continued/forked sessions itself. Inserting
    # before -- preserves literal run messages and workspace arguments.
    if "--standalone" in options["connection_args"]:
        return argv
    index = argv.index("--") if "--" in argv else len(argv)
    return argv[:index] + ["--standalone"] + argv[index:]


def build_claude_args(argv, connection_info):
    mcp_config = {
        "mcpServers": {
            "naia": {
                "type": "http",
                "url": connection_info["url"],
                "headers": {"Authorization": "Bearer ${" + MCP_TOKEN_ENV + "}"},
            }
        }
    }

    # No --strict-mcp-config: this merges the Naia MCP server with the
    # user's existing global/project MCP servers instead of replacing them.
    # This server now includes tools from other providers, so do not blanket
    # auto-approve it. Leave shared-server permissions to the harness/user.
    extra = [
        "--mcp-config",
        json.dumps(mcp_config),
    ]

    instructions = read_agent_instructions()
    if not instructions or not instructions.strip():
        raise ValueError("cannot launch Naia without readable, non-empty agent instructions")
    extra += ["--append-system-prompt", instructions]

    # Re-inject a lightweight reminder on every turn so the core Naia rules
    # never drift out of context. The reminder text lives in its own file
    # (agent-reminder.md) so it can be edited without touching this script.
    if os.path.exists(AGENT_REMINDER_FILE):
        hook_settings = {
            "hooks": {
                "UserPromptSubmit": [
                    {
                        "hooks": [
                            {
                                "type": "command",
                                "command": f"cat {shlex.quote(AGENT_REMINDER_FILE)}",
                            }
                        ]
                    }
                ]
            }
        }
        extra += ["--settings", json.dumps(hook_settings)]

    return extra + argv


def build_codex_args(argv, connection_info):
    instructions = read_agent_instructions()
    if not instructions or not instructions.strip():
        raise ValueError("cannot launch Naia without readable, non-empty agent instructions")
    # Replace this server as a whole, so an inherited old stdio command cannot
    # conflict with the new URL. Neither the override nor instructions contain a token.
    server = ("{ url = " + json.dumps(connection_info["url"])
              + ", bearer_token_env_var = " + json.dumps(MCP_TOKEN_ENV) + ", enabled = true }")
    extra = [
        "-c",
        "mcp_servers.naia=" + server,
        "-c",
        f"model_instructions_file={json.dumps(AGENT_INSTRUCTIONS_FILE)}",
    ]
    return extra + argv


def main():
    if len(sys.argv) < 2:
        warn("expected target CLI name")
        return 1

    target = sys.argv[1]
    target_args = sys.argv[2:]
    env = os.environ.copy()
    env.pop(MCP_TOKEN_ENV, None)  # Do not reuse another editor's inherited token.

    connection_info = get_naia_connection_info()
    if not connection_info:
        warn("Naia bridge info unavailable, launching without injected MCP config")
        notify_nvim("Naia bridge info unavailable, launching without injected MCP config", "WARN")

    try:
        if target == "opencode":
            if connection_info:
                # Administrative commands must not inherit Naia's launch config.
                if opencode_session_options(target_args) is not None:
                    target_args = build_opencode_args(target_args)
                    env = build_opencode_env(env, connection_info)
                    notify_nvim("Launching private opencode with Naia MCP and instructions")
        elif target == "codex":
            if connection_info:
                env[MCP_TOKEN_ENV] = connection_info["token"]
                notify_nvim("Launching codex with Naia MCP")
                target_args = build_codex_args(target_args, connection_info)
        elif target == "claude":
            if connection_info:
                env[MCP_TOKEN_ENV] = connection_info["token"]
                notify_nvim("Launching claude with Naia MCP")
                target_args = build_claude_args(target_args, connection_info)
        else:
            warn(f"unsupported target CLI: {target}")
            return 1
    except (ValueError, KeyError, TypeError, OSError) as error:
        warn(f"failed to prepare {target} MCP/instructions: {error}")
        notify_nvim("Failed to prepare Naia MCP/instructions; launch cancelled (see terminal)", "ERROR")
        return 1

    os.execvpe(target, [target] + target_args, env)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
